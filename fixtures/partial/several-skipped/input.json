{
  "color": { "brand": { "$value": "#5A4FCF" }, "alias": { "$value": "{color.brand}" } },
  "type": { "body": { "$value": { "fontSize": "16px" }, "$type": "typography" } },
  "border": { "focus": { "$value": { "width": "2px", "style": "solid" }, "$type": "border" } },
  "elevation": { "low": { "$value": { "color": "{color.brand}", "offsetX": "0px", "offsetY": "2px", "blur": "6px" }, "$type": "shadow" } },
  "gradient": { "hero": { "$value": [{ "color": "{color.brand}", "position": 0 }, { "color": "#fff", "position": 1 }], "$type": "gradient" } },
  "motion": { "ease": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" } },
  "spacing": { "md": { "$value": "16px" } }
}
