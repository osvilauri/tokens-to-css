{
  "$description": "Scalars the spec writes as arrays: font families and easing curves (FR-26). Every fontFamily notation the 2026-09-02 survey found in published files appears here.",
  "font": {
    "family": {
      "mono": { "$value": ["Monaco", "Consolas", "Lucida Console", "monospace"], "$type": "fontFamily" },
      "system": { "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"], "$type": "fontFamily" },
      "display": { "$value": ["SF Pro"], "$type": "fontFamily" },
      "prequoted": { "$value": ["'Mona Sans VF', Helvetica, sans-serif"], "$type": "fontFamily" },
      "string": { "$value": "'Segoe UI', -apple-system, sans-serif", "$type": "fontFamily" }
    }
  },
  "easing": {
    "linear": { "$value": [0, 0, 1, 1], "$type": "cubicBezier" },
    "emphasized": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" },
    "overshoot": { "$value": [0.5, -0.5, 0.5, 1.5], "$type": "cubicBezier" }
  },
  "semantic": {
    "code": { "$value": "{font.family.mono}" },
    "motion": { "$value": "{easing.emphasized}" }
  }
}
