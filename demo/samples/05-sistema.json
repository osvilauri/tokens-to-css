{
  "$description": "Un sistema pequeño pero completo · primitivos, capa semántica y componentes. Todo lo que el epic añadió, trabajando junto y encadenado por referencias.",
  "primitive": {
    "purple": {
      "500": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.353, 0.31, 0.812] } },
      "050": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.965, 0.961, 0.992] } }
    },
    "grey": {
      "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.098, 0.086, 0.153] } },
      "veil": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12 } }
    },
    "space": {
      "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
    },
    "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "swift": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "semantic": {
    "color": {
      "accent": { "$value": "{primitive.purple.500}" },
      "surface": { "$value": "{primitive.purple.050}" },
      "text": { "$value": "{primitive.grey.900}" },
      "scrim": { "$value": "{primitive.grey.veil}" }
    },
    "elevation": {
      "card": { "$type": "shadow", "$value": { "color": "{semantic.color.scrim}", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "-2px" } }
    },
    "motion": {
      "enter": { "$type": "transition", "$value": { "duration": { "value": 160, "unit": "ms" }, "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{primitive.swift}" } }
    },
    "type": {
      "body": { "$type": "typography", "$value": { "fontFamily": "{primitive.sans}", "fontSize": { "value": 1, "unit": "rem" }, "fontWeight": 400, "letterSpacing": "0px", "lineHeight": 1.5 } }
    }
  },
  "component": {
    "card": {
      "background": { "$value": "{semantic.color.surface}" },
      "padding": { "$value": "{primitive.space.2}" },
      "shadow": { "$value": "{semantic.elevation.card}" },
      "border": { "$type": "border", "$value": { "color": "{semantic.color.accent}", "width": "{primitive.space.1}", "style": "solid" } }
    }
  }
}
